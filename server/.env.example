# ---- Required ----
MONGO_URI=mongodb://127.0.0.1:27017/hotelpro
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
CLIENT_URL=http://localhost:5173
PORT=5000

# ---- Optional ----
JWT_EXPIRES_IN=1d
# Key used to encrypt guest phone numbers at rest (falls back to JWT_SECRET)
ENCRYPTION_KEY=
# Minutes a room is held while the guest pays
HOLD_MINUTES=15
CURRENCY=inr

# Payments. Leave STRIPE_SECRET_KEY empty to use the built-in demo card flow (4242 4242 4242 4242).
# Use Stripe TEST keys (sk_test_...). STRIPE_WEBHOOK_SECRET is only needed for webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to false to turn the demo payment flow off completely
DEMO_PAYMENTS=true

# Email (Nodemailer). Leave SMTP_HOST empty to skip sending - messages are written to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=HotelPro <no-reply@hotelpro.local>
